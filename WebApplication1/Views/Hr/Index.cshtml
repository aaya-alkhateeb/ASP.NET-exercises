@model List<WebApplication1.Models.ViewModels.EmployeeView>

@{
    bool showDeleted = ViewBag.empDType == "deleted";
    int counter = 1;
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Employees</h1>
            <span class="text-muted small">
                @ViewBag.NumberOfEmployees employees
            </span>
        </div>

        @if (ViewBag.IsAdmin)
        {
            <a asp-controller="Hr"
           asp-action="Create"
           class="btn btn-dark rounded-pill px-4">
            + Add Employee
        </a>
        }
        
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="p-6 border-bottom">
            <div class="row g-6">

                <div class="col-md-12">
                    <form asp-action="index"
                          asp-controller="hr"
                          method="get"
                          class="d-flex gap-2 inline">
                        <input type="search"
                               id="employeeSearch"
                               class="form-control"
                               placeholder="Search employees..."
                               aria-label="Search employees"
                               name="searchQuery"
                               value="@ViewBag.searchQuery"
                                />
                        <button type="submit" asp-action="index" asp-controller="hr" class="btn btn-dark px-3 mt-2 mt-md-0">
                            Search
                        </button>
                        <a asp-action="index" class="btn btn-outline-secondary px-3 mt-2 mt-md-0">Clear</a>

                        <select id="EmployeeDFilter"
                                name="empDType"
                                class="form-select"
                                aria-label="Employee status">
                            @if (showDeleted)
                            {
                                <option value="active">Active Employees</option>
                                <option value="deleted" selected>Deleted Employees</option>
                            }
                            else
                            {
                                <option value="active" selected>Active Employees</option>
                                <option value="deleted">Deleted Employees</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-dark px-3">
                            Apply
                        </button>
                    </form>
                    
                </div>


            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="text-center text-muted py-5">
                No employees found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small">
                            <th scope="col" class="ps-4 py-3">#</th>
                            <th scope="col">Name</th>
                            <th scope="col">Salary</th>
                            <th scope="col">Hire Date</th>
                            <th scope="col">Department</th>
                            @if (ViewBag.IsAdmin)
                            {
                                <th scope="col" class="text-end pe-4">Actions</th>
                            }
                            
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <th scope="row" class="ps-4 py-3 text-muted">
                                    @counter
                                </th>

                                <td class="fw-bold">
                                    @employee.Employee_Name
                                </td>

                                <td class="text-nowrap">
                                    @employee.salary
                                </td>

                                <td class="text-muted text-nowrap">
                                    @employee.HireDate
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                                        @employee.DepartmentName
                                    </span>
                                </td>

                                @if (ViewBag.IsAdmin)
                                {
                                    <td class="text-end text-nowrap pe-4">
                                    @if (showDeleted)
                                    {
                                        <form asp-controller="Hr"
                                              asp-action="Restore"
                                              asp-route-id="@employee.Employee_Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Are you sure you want to restore this employee?');">
                                                Restore
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Hr"
                                           asp-action="Edit"
                                           asp-route-id="@employee.Employee_Id"
                                           class="btn btn-sm btn-outline-secondary me-1">
                                            Edit
                                        </a>

                                        <form asp-controller="Hr"
                                              asp-action="Delete"
                                              asp-route-id="@employee.Employee_Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this employee?');">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                                }

                                
                            </tr>

                            counter++;
                        }
                    </tbody>
                </table>
            </div>


            @if (ViewBag.IsAdmin)
            {
                <div class="p-3 border-top text-end">
                <a asp-controller="Hr"
                   asp-action="CreateDepartment"
                   class="btn btn-sm btn-outline-dark rounded-pill px-3">
                    + Add Department
                </a>
            </div>
            }
            
        }
    </div>

</div>