@model WebApplication1.Models.Employee

<h1>Create Employee</h1>

<form asp-controller="Hr" asp-action="Create" method="post">

@Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="Employee_Name"></label>
        <input asp-for="Employee_Name" class="form-control" />
        <span asp-validation-for="Employee_Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="salary"></label>
        <input asp-for="salary" class="form-control" />
        <span asp-validation-for="salary" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="DepartmentId"></label>
        <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.Departments">
            <option value="">Select Department</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>

</form>


